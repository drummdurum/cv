MAIL_SERVICE_URL=https://din-mail-api.up.railway.app
MAIL_SERVICE_API_KEY=DIN_CV_API_NØGLE
# Deploy også den opdaterede bouldeMailService (API og worker).
MAIL_CALENDAR_ENDPOINT=/emails/calendar
# Arrangøren modtager kalendersvar; samme adresse sættes i mailservicens CALENDAR_ORGANIZER_EMAIL.
EVENT_ORGANIZER_EMAIL=sedrumm@gmail.com
# Afsenderen fra invitationer sendt før Gmail-opsætningen; bruges til gamle aflysninger.
EVENT_LEGACY_ORGANIZER_EMAIL=no-reply@sebastiandrumm.dk
# Separat Google Cloud-projekt: sebastiandrumm-dk. Aktivér først efter OAuth-godkendelse.
EVENT_CALENDAR_PROVIDER=mail
GOOGLE_CALENDAR_ACCOUNT=sedrumm@gmail.com
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Docker Compose: brug lange, tilfældige værdier i din lokale .env
MONGO_ROOT_PASSWORD=SKIFT_TIL_EN_TILFAELDIG_ADGANGSKODE
EVENT_COOKIE_SECRET=SKIFT_TIL_EN_LANG_TILFAELDIG_HEMMELIGHED
# Mindst 32 tegn: viser adminpaneler til gæster og kalenderstatus på /event.
EVENT_ADMIN_KEY=
# Komma-separerede ekstra origins, hvis eventdelen bruges på andre domæner
EVENT_ALLOWED_ORIGINS=
