<!doctype html>
<html lang="da">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Eventer</title>
  <link rel="stylesheet" href="/event/event.css">
  <link rel="stylesheet" href="/event/gloegg.css">
  <% if (guestRemovalEnabled) { %><link rel="stylesheet" href="/event/guest-admin.css"><% } %>
</head>
<body>
  <header class="site-header"><div class="shell header-inner"><a class="brand" href="/event">samlet<span>.</span></a><span class="header-note">Plads til gode oplevelser</span></div></header>
  <main>
    <section class="hero shell">
      <div class="eyebrow"><span class="eyebrow-line"></span> DET SKER SNART</div>
      <h1>Det er bedre<br><em>sammen.</em></h1>
      <p>Find et event, vær med til at forme det, og mød op til noget godt. Her finder du de kommende arrangementer.</p>
      <a class="hero-link" href="#events">Se eventer <span aria-hidden="true">↗</span></a>
      <div class="hero-index">01 / EVENTER</div>
    </section>
    <section class="events-section" id="events"><div class="shell">
      <div class="section-heading"><div><div class="eyebrow light">KOMMENDE ARRANGEMENTER</div><h2>Find din næste<br><em>oplevelse.</em></h2></div><span><%= events.length %> eventer</span></div>
      <% if (guestRemovalEnabled && guestNotice) { %><p role="status"><%= guestNotice %></p><% } %>
      <div class="event-grid">
        <% events.forEach((event, index) => { %>
        <div>
        <a class="event-card<%= event.id === 'gloegg-og-hygge' ? ' gloegg-card' : '' %>" href="/event/<%= event.id %>">
          <div class="card-top"><span><%= String(index + 1).padStart(2, '0') %> / <%= event.category %></span><span class="card-arrow">↗</span></div>
          <div class="card-content"><div class="card-date"><%= event.cancelled ? 'AFLYST · ' : '' %><%= event.date %> · <%= event.time %></div><h3><%= event.title %></h3><p><%= event.description %></p></div>
          <div class="card-bottom"><span><%= event.place %></span><strong>Udforsk eventet <span aria-hidden="true">→</span></strong></div>
        </a>
        <% if (guestRemovalEnabled) { %>
          <details class="guest-admin" <%= invitationReport?.eventId === event.id ? 'open' : '' %>>
            <summary>Kalenderinvitationer</summary>
            <form method="post" action="/event/admin/invitations">
              <input type="hidden" name="eventId" value="<%= event.id %>">
              <label>Adminnøgle <input type="password" name="adminKey" autocomplete="off" required></label>
              <button type="submit">Tjek kalenderinvitationer</button>
              <% if (event.startsAt && !event.cancelled) { %><button type="submit" name="operation" value="send_missing">Send manglende invitationer</button><% } %>
            </form>
            <% if (invitationReport?.eventId === event.id) { %>
              <% const labels = { sent: 'Sendt', queued: 'I kø', sending: 'Behandles', not_sent: 'Ikke sendt', failed: 'Fejlet', unknown: 'Uafklaret', unavailable: 'Eventets tidspunkt er ikke fastlagt' }; %>
              <div class="invitation-report" role="status">
                <% if (invitationReport.notice) { %><p><%= invitationReport.notice %></p><% } %>
                <% if (invitationReport.error) { %><p><%= invitationReport.error %></p><% } else { %>
                  <p><strong><%= invitationReport.rows.filter(row => row.status === 'sent').length %> af <%= invitationReport.rows.length %> invitationer er sendt.</strong></p>
                  <% if (!event.startsAt) { %><p>Kalenderinvitationer kræver en fastlagt dato og tid.</p><% } %>
                  <% if (!invitationReport.total) { %><p>Ingen tilmeldte endnu.</p><% } %>
                  <% if (invitationReport.total > invitationReport.rows.length) { %><p>Viser de første <%= invitationReport.rows.length %> af <%= invitationReport.total %> tilmeldte.</p><% } %>
                  <ul class="invitation-status-list">
                    <% invitationReport.rows.forEach(row => { %>
                      <% const deliveries = { delivered: 'Leveret til mailserver', bounced: 'Afvist af mailserver', delayed: 'Levering forsinket', failed: 'Levering fejlet', complained: 'Markeret som spam', unknown: 'Levering ikke bekræftet' }; const replies = { accepted: 'Accepteret', declined: 'Afslået', tentative: 'Måske', needs_action: 'Intet kalendersvar' }; %>
                      <li><strong><%= row.name %></strong> — <%= labels[row.status] || 'Uafklaret' %><% if (row.sentAt) { %> · <%= new Date(row.sentAt).toLocaleString('da-DK', { timeZone: 'Europe/Copenhagen' }) %><% } %><br><%= deliveries[row.deliveryStatus] || deliveries.unknown %> · <%= replies[row.calendarResponse] || replies.needs_action %><% if (row.checkFailed) { %> (kunne ikke opdateres; viser senest gemte status)<% } %></li>
                    <% }) %>
                  </ul>
                  <% if (invitationReport.cancellations?.length) { %>
                    <h4>Kalenderaflysninger</h4><ul>
                      <% invitationReport.cancellations.forEach(item => { %><li><%= item.name %> — <%= ({ SENT: 'Aflysning sendt', QUEUED: 'Aflysning i kø', FAILED: 'Aflysning fejlet' })[item.status] || 'Aflysning ikke bekræftet' %></li><% }) %>
                    </ul>
                  <% } %>
                  <p>“Sendt” er mailafsendelse. Kalendersvar vises separat og opdateres, når du tjekker. Manglende svar betyder ikke et afslag.</p>
                <% } %>
              </div>
            <% } %>
          </details>
          <details class="guest-admin">
            <summary><%= event.cancelled ? 'Prøv resterende kalenderaflysninger igen' : 'Aflys hele eventet' %></summary>
            <p>Eventet lukkes for tilmelding. Tilmeldte med en invitation får en kalenderaflysning.</p>
            <form method="post" action="/event/admin/invitations">
              <input type="hidden" name="eventId" value="<%= event.id %>">
              <input type="hidden" name="operation" value="cancel_event">
              <label>Adminnøgle <input type="password" name="adminKey" autocomplete="off" required></label>
              <button type="submit">Aflys event og send kalenderaflysninger</button>
            </form>
          </details>
          <details class="guest-admin">
            <summary>Fjern gæst</summary>
            <form method="post" action="/event/admin/remove-guest">
              <input type="hidden" name="eventId" value="<%= event.id %>">
              <label>Gæstens mail <input type="email" name="email" maxlength="254" required></label>
              <label>Adminnøgle <input type="password" name="adminKey" autocomplete="off" required></label>
              <button type="submit">Fjern tilmelding</button>
            </form>
          </details>
        <% } %>
        </div>
        <% }) %>
      </div>
    </div></section>
    <section class="quiz-section" id="quiz"><div class="shell">
      <div class="eyebrow"><span class="eyebrow-line"></span> TEST DIN VIDEN</div>
      <div class="quiz-section-heading"><h2>Tre emner.<br><em>Ét spørgsmål ad gangen.</em></h2><p>Vælg en quiz, svar på 20 spørgsmål og se din score efter hvert svar.</p></div>
      <div class="quiz-overview-grid">
        <% quizzes.forEach((quiz) => { %>
        <a class="quiz-overview-card" href="/event/quiz/<%= quiz.id %>"><span class="quiz-overview-number"><%= quiz.count %> SPØRGSMÅL</span><h3><%= quiz.title %></h3><p><%= quiz.description %></p><span class="quiz-overview-link">Åbn quiz <span aria-hidden="true">↗</span></span></a>
        <% }) %>
      </div>
    </div></section>
  </main>
  <footer class="site-footer"><div class="shell footer-inner"><span>samlet<span class="accent">.</span></span><span>Gode oplevelser begynder her.</span></div></footer>
</body>
</html>
