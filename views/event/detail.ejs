<!doctype html>
<html lang="da">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= event.title %> · Event</title>
  <link rel="stylesheet" href="/event/event.css">
  <% const isGloegg = event.id === 'gloegg-og-hygge'; %>
  <% const brandName = isGloegg ? 'samlet om gløggen' : 'samlet'; %>
  <% if (isGloegg) { %><link rel="stylesheet" href="/event/gloegg.css"><% } %>
  <% if (event.id === 'julefrokst') { %><link rel="stylesheet" href="/event/christmas.css"><% } %>
</head>
<body class="<%= isGloegg ? 'gloegg-event' : event.id === 'julefrokst' ? 'christmas-event' : '' %>" data-event-id="<%= event.id %>" data-event-title="<%= event.title %>">
  <header class="site-header"><div class="shell header-inner">
    <% if (isGloegg) { %>
      <span class="brand"><%= brandName %><span>.</span></span>
    <% } else { %>
      <a class="brand" href="/event"><%= brandName %><span>.</span></a>
      <a class="header-back" href="/event">← Alle eventer</a>
    <% } %>
  </div></header>
  <main><% if (event.cancelled) { %><p class="shell" role="status">Dette event er aflyst. Der er lukket for tilmelding.</p><% } %>
    <section class="detail-hero shell" id="julefrokost-info">
      <% if (event.id === 'julefrokst') { %><div class="christmas-snow" aria-hidden="true"><span>✦</span><span>❄</span><span>✧</span><span>❄</span><span>✦</span><span>❄</span><span>✧</span><span>❄</span><span>✦</span><span>❄</span><span>✧</span><span>❄</span></div><div class="christmas-orb" aria-hidden="true">✷</div><div class="christmas-kicker">✦ &nbsp; EN AFTEN I DECEMBER &nbsp; ✦</div><% } %>
      <div class="eyebrow"><span class="eyebrow-line"></span> <%= event.category.toUpperCase() %></div>
      <h1><%= event.title %><span>.</span></h1>
      <p><%= event.description %></p>
      <% if (isGloegg) { %>
        <figure class="gloegg-portrait">
          <img src="/event/gloegg.webp" width="1080" height="1080" alt="To glas gløgg med appelsin og kanel omgivet af grangrene">
          <div class="gloegg-snow" aria-hidden="true">
            <% for (let i = 0; i < 8; i++) { %><span><%= i % 3 === 0 ? '✧' : '•' %></span><% } %>
          </div>
        </figure>
      <% } %>
      <% if (event.id === 'julefrokst') { %><div class="christmas-video-window"><iframe src="https://www.youtube-nocookie.com/embed/bMTkGzy6-yo?start=8&autoplay=1&mute=1&loop=1&playlist=bMTkGzy6-yo&controls=1&playsinline=1" title="Tuborg Julebryg på YouTube" allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe><a href="https://www.youtube.com/watch?v=bMTkGzy6-yo&t=8s" target="_blank" rel="noopener noreferrer">Åbn videoen på YouTube ↗</a></div><% } %>
      <div class="detail-facts"><div><small>DATO</small><strong><%= event.date %></strong></div><div><small>TID</small><strong><%= event.time %></strong></div><div><small>STED</small><strong><% if (event.mapQuery) { %><a class="event-map-link" href="https://www.google.com/maps/search/?api=1&amp;query=<%= encodeURIComponent(event.mapQuery) %>" target="_blank" rel="noopener noreferrer"><%= event.place %> <span aria-hidden="true">↗</span></a><% } else { %><%= event.place %><% } %></strong></div><button class="participate-button" id="participate-button" type="button">Deltag i eventet ↗</button></div>
    </section>
    <section class="detail-body"><div class="shell">
      <div class="detail-layout"><div class="main-column">
      <div class="tabs" role="tablist" aria-label="Eventindhold"><button class="tab active" role="tab" aria-selected="true" data-tab="info">Info</button><button class="tab" role="tab" aria-selected="false" data-tab="vote">Afstemning</button></div>
      <div class="tab-panel" id="info-panel" role="tabpanel">
        <div class="content-label">01 / OM EVENTET</div><h2>Vi ses der.</h2><p><%= event.details || event.description %></p><p><%= isGloegg ? 'Stem på, om vi skal have julemusik til gløggen.' : 'Du kan være med til at bestemme en del af programmet. Gå til afstemningen og giv din stemme.' %></p><button class="button" data-open-vote>Gå til afstemning <span>↗</span></button>
      </div>
      <div class="tab-panel" id="vote-panel" role="tabpanel" hidden>
        <div class="content-label">02 / VÆR MED TIL AT BESTEMME</div><h2>Din stemme tæller.</h2><p>Vælg det, du helst vil. Resultatet opdateres med det samme for alle, der er på siden.</p>
        <div class="vote-card"><div class="vote-top"><span>AFSTEMNING</span><span id="connection-status">Forbinder…</span></div><h3><%= event.question %></h3><div id="vote-options">
          <% event.options.forEach((option, index) => { %><button class="vote-option" data-option="<%= index %>"><span class="option-text"><%= option %></span><span class="option-count" data-count="<%= index %>">0</span><span class="option-bar" data-bar="<%= index %>"></span></button><% }) %>
        </div><div class="vote-footer"><span id="vote-feedback" aria-live="polite">Vælg en mulighed for at stemme.</span><span id="vote-total">0 stemmer</span></div></div>
      </div>
      </div><aside class="side-column" id="participation"><div class="echo-box"><div class="content-label">DELTAG I EVENTET</div><h3 id="side-title">Vær med</h3><p id="registration-intro">Skriv navn og mail for at deltage i afstemningen og samtalen.</p><form id="name-form"><label for="participant-name">Dit navn</label><div class="name-form-row"><input id="participant-name" name="name" minlength="2" maxlength="40" required autocomplete="name" placeholder="Dit navn"><label for="participant-email">Din mail</label><input id="participant-email" name="email" type="email" maxlength="254" required autocomplete="email" placeholder="dig@eksempel.dk"><button type="submit">Deltag ↗</button></div></form><div id="known-participant" hidden><p>Du er oprettet som <strong id="known-name"></strong> (<span id="known-email"></span>).</p><button class="join-button" id="join-event" type="button">Tilmeld dette event ↗</button></div><div id="participant-display" hidden>Du deltager som <strong id="participant-name-display"></strong>.</div><div id="name-result" class="echo-result" aria-live="polite"></div><section id="calendar-invitation" hidden aria-label="Kalenderinvitation"><p id="invitation-status" role="status"></p><button id="check-invitation" type="button">Tjek invitation</button></section><section class="attendees" aria-label="Deltagere"><div class="attendees-heading"><h4>Deltagere</h4><strong id="attendee-count" aria-live="polite">0</strong></div><p id="attendee-empty">Ingen tilmeldinger endnu.</p><ul id="attendee-list"></ul><p id="attendee-more" hidden></p></section><div id="chat-section" hidden><div class="chat-heading">Samtalen</div><div id="chat-messages" class="chat-messages" aria-live="polite"></div><form id="chat-form"><label for="chat-message">Skriv til deltagerne</label><div class="name-form-row"><textarea id="chat-message" maxlength="500" required placeholder="Skriv en besked..."></textarea><button type="submit">Send besked ↗</button></div></form><div id="chat-result" class="echo-result" aria-live="polite"></div></div><% if (!isGloegg) { %><details class="echo-details" id="echo-details" hidden><summary>Test gRPC Echo</summary><p>En teknisk forbindelsestest, som sender din tekst tilbage.</p><form id="echo-form"><label for="echo-message">Din testbesked</label><div class="echo-form-row"><input id="echo-message" name="message" maxlength="500" required placeholder="Skriv noget her..."><button type="submit">Test ↗</button></div></form><div id="echo-result" class="echo-result" aria-live="polite"></div></details><% } %></div></aside></div>
    </div></section>
  </main>
  <footer class="site-footer"><div class="shell footer-inner"><span><%= brandName %><span class="accent">.</span></span><% if (!isGloegg) { %><a href="/event">Tilbage til eventer ↗</a><% } %></div></footer>
  <script src="/event/event.js" defer></script>
</body>
</html>
