{
  "name": "cv-sebastian-drumm",
  "version": "1.0.0",
  "description": "Sebastian Drumm CV website med EJS og Tailwind CSS",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "build": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --minify",
    "build:css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --watch",
    "railway:build": "npm ci && npm run build",
    "test:e2e": "playwright test",
    "event:echo": "node event/echo-client.js",
    "event:quiz": "node event/quiz-client.js"
  },
  "keywords": [
    "cv",
    "portfolio",
    "ejs",
    "tailwind"
  ],
  "author": "Sebastian Drumm",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.9",
    "express": "^4.22.3",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "mongodb": "^6.21.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "nodemon": "^3.0.2",
    "tailwindcss": "^3.4.19"
  },
  "overrides": {
    "filelist": {
      "minimatch": "^5.1.9"
    }
  }
}
